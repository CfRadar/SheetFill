# ==============================================================================
# Flipkart Sheet Filler - Subscription & Access Control Configuration
# ==============================================================================

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# MongoDB Database Name
MONGODB_DB=sheetfill

# Long random secret key used for signing JWT access tokens (at least 32 characters)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_long_random_secret_at_least_32_characters

# Application Owner / Administrator Credentials
ADMIN_USERNAME=admin
# Generate hash via: python scripts/make_admin_hash.py
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$c29tZXNhbHQ$RdescudvT2ub6Kf3SOHq/akCRWicq2U0/GyLReFLuPQ

# Allowed CORS Origin for the Frontend (no trailing slash, no wildcard in production)
FRONTEND_ORIGIN=http://localhost:3000

# Access Token Expiry in minutes (default: 480 min = 8 hours)
ACCESS_TOKEN_MINUTES=480

# Single-Device Session Policy: "replace" (default) or "block"
# - replace: logging into a new device automatically terminates any older active session
# - block: rejects new logins if an active session is already running elsewhere
SESSION_POLICY=replace

# Runtime Environment: "development" or "production"
# In production, /docs, /redoc, and /openapi.json are disabled
ENV=development

# Maximum file upload size in megabytes (default: 10)
MAX_UPLOAD_MB=10

# ==============================================================================
# Marketplace Keyword Agent (BYOK Key Encryption)
# ==============================================================================
# 32 url-safe base64-encoded bytes used by Fernet to encrypt per-user OpenRouter keys at rest.
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEYWORD_AGENT_ENCRYPTION_KEY=replace_with_a_fernet_key
